# Public repository allowlist. Local collections and operations stay on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/README.zh-CN.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/SECURITY.md
!/requirements.txt
!/package.json
!/package-lock.json
!/.github/
!/docs/
!/tools/
!/site/
!/pelican-web/
/pelican-web/*
!/pelican-web/data.js
/site/captures/*
!/site/captures/manifest.json
/site/deploy/
/tools/oauth-wait.cjs
**/__pycache__/
**/*.pyc
**/*.tmp
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules/
**/playwright-report/
**/test-results/
